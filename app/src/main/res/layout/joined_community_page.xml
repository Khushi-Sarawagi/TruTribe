<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/back_arrow"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/round_arrow_back_24"
            android:contentDescription="@string/back_arrow" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/baseline_dehaze_24"
                android:layout_marginEnd="10dp"
                android:layout_marginStart="10dp"
                android:contentDescription="@string/three_dash"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="30sp"
                android:fontFamily="@font/italiana_regular"
                android:textColor="@color/black"/>
        </LinearLayout>
    </LinearLayout>











    <FrameLayout
        android:id="@+id/frame_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/tablayout"
        >

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">








                <!-- Community Banner -->
                <ImageView
                    android:id="@+id/community_banner"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:layout_margin="10dp"
                    android:contentDescription="@string/community_banner" />

                <!-- Community Title -->
                <TextView
                    android:id="@+id/community_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:padding="10dp"
                    android:text="Community Title"
                    android:textSize="25sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/italiana_regular"
                    android:letterSpacing="0.1" />

                <!-- Grid of 2x2 Square Cards -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/square_cards_grid"
                    android:layout_width="match_parent"
                    android:layout_height="195dp"
                    android:layout_margin="10dp"
                    android:clipToPadding="false"
                    android:padding="4dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="2"
                    tools:listitem="@layout/square_card" />

                <!-- Rectangle Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/rectangle_card"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_margin="10dp"
                    android:layout_gravity="center_horizontal"
                    android:elevation="4dp"
                    app:cardCornerRadius="12dp"
                    android:backgroundTint="@android:color/white">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rectangle Card Content"
                        android:textSize="18sp"
                        android:padding="16dp"
                        android:textColor="@color/black" />
                </androidx.cardview.widget.CardView>


            </LinearLayout>
        </ScrollView>
    </FrameLayout>


    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tablayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:tabIconTint="@null"
        app:tabIndicatorHeight="0dp"
        app:tabMode="fixed">

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_home"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/home" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/search" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/notification" />

        <com.google.android.material.tabs.TabItem
            android:id="@+id/tab_profile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:icon="@drawable/profile" />


    </com.google.android.material.tabs.TabLayout>

</RelativeLayout>

